{
  "id": "/",
  "name": "Finnbook",
  "short_name": "Finnbook",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f2f4ec",
  "theme_color": "#f2f4ec",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "video/*"
          ]
        }
      ]
    }
  }
}
