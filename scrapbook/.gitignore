# macOS
.DS_Store

# Local Claude Code settings
.claude/settings.local.json

# Phase 2: PocketBase binary + its SQLite data / uploaded files.
# pb_migrations/ is NOT ignored — the schema is source and belongs in the repo.
pocketbase
pb_data/

# Node (tests only — there is no build step)
node_modules/

# Sample media for the preview bench. Dropped in by hand, not part of the app: a phone
# clip is tens of megabytes and would sit in git history forever. preview.html renders
# video cards from their posters without it — only playback needs the file.
assets/sample-clip.*

# Telegram bot: secrets and its polling cursor. Never commit either — the token is a
# password, and a stale offset would replay or skip messages on another machine.
.env
bot/.offset

# Where a detached bot writes its output. Run in a terminal it goes to the terminal, and
# that terminal closing is how the only record of a signed-in-to-which-host line is lost.
bot/bot.log
