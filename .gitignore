# Cross-cutting only. Each app keeps its own .gitignore for its own build artefacts and
# local state — scrapbook/.gitignore is where pb_data/, the PocketBase binary and the
# bot's secrets are excluded, and those patterns resolve relative to that file.

.DS_Store
.claude/settings.local.json
node_modules/

# Key material. A VAPID private key reached a commit once, from a file sitting in the
# repo root during setup; the pair had to be rotated. Keys belong in Render's environment,
# never on disk here.
*.pem
*.key
.*.swp
