# Telegram bot settings. Copy this file to .env and fill in the blanks:
#
#   cp .env.example .env
#   node bot/index.js
#
# .env is gitignored. This template is not — it holds no secrets, and never should.

# From @BotFather, when you created the bot. Treat it as a password: anyone holding it
# can act as your bot.
TELEGRAM_BOT_TOKEN=

# The PocketBase account the bot signs in as. Create it in the admin UI under
# Collections -> users, and leave its telegramId blank.
PB_BOT_EMAIL=bot@scrapbook.local
PB_BOT_PASSWORD=

# Where PocketBase is. The default is right for the local setup; uncomment to change.
# PB_URL=http://127.0.0.1:8090
